{
  "expo": {
    "name": "University Park Lions",
    "slug": "lions-club-mobile",
    "version": "0.1.7",
    "orientation": "portrait",
    "scheme": "lionsclub",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.picklescoop.lionsclub",
      "buildNumber": "8",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["fb","instagram","youtube","twitter","linkedin","barcelona","snssdk1233","discord","pinterest","snapchat","whatsapp","tg"]
      }
    },
    "android": {
      "package": "com.picklescoop.lionsclub",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": ["expo-router","expo-secure-store","expo-notifications"],
    "extra": {"apiBase": "https://uplc.picklescoop.com/wp-json/lcm-mobile/v1"},
    "splash": {"image":"./assets/splash-icon.png","resizeMode":"contain","backgroundColor":"#FFFFFF"}
  }
}
